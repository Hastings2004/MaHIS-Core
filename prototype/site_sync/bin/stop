#!/bin/bash
# Stop prototype processes. bin/stop [all|agents|agent_a|server_b|...]
source "$(dirname "$0")/../env.sh" central >/dev/null
PIDS="$PROTO_TMP/pids"
what="${1:-all}"
for f in "$PIDS"/*.pid; do
  [ -e "$f" ] || continue
  name="$(basename "$f" .pid)"
  case "$what" in
    all) ;;
    agents) [[ "$name" == agent_* ]] || continue ;;
    *) [ "$name" = "$what" ] || continue ;;
  esac
  pid="$(cat "$f")"
  kill "$pid" 2>/dev/null && echo "stopped $name"
  rm -f "$f"
done
