# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle
Gemfile.lock

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# MaHIS bulk user import secrets/data
config/users.yml
data/*.xlsx
log/mahis-user-import-*.log

# Ignore uploaded files in development
/storage/*
!/storage/.keep

.byebug_history

# Ignore master key for decrypting credentials and more.
/config/master.key
#Ignoring yml files under configuration
config/*.yml
# ...except the sync table config, which holds no secrets and is required.
!config/site_sync_tables.yml

#Ignoring files created by passenger (if using passenger to run app)
*.pid.lock
*.pid
db/schema.rb
db/structure.sql

*.DS_Store

*.swp

HEAD

master.key

credentials.yml.enc

config/server/

# Ignore all migration generated reports
*migration*.csv
names_mismatch.csv
migration*.log
extensions.json
emc_ipt_duplicates*.csv
# Ignore json files under idsr
db/idsr_metadata/*.json

# Ignore json files under lims
db/lims_metadata/*.json

.solargraph.yml
.vscode
.idea
.claude
vendor_bk

# Ignore json files under hts_metadata
db/hts_metadata/*.json

# f bups
db/data/facilities/backups/

# Ignore key files for decrypting credentials and more.
/config/*.key

